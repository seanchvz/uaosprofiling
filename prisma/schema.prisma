generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model events {
  id           Int      @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime
  Sport        String
  CreatedAt    DateTime @default(now())
  UpdatedAt    DateTime @updatedAt
  eventDetails String?
  isExternal   Boolean  @default(false)
  isInternal   Boolean  @default(false)
  userId       String
}

model studentprofile {
  id               Int     @id @default(autoincrement())
  firstName        String  @unique(map: "StudentProfile_firstName_key")
  middleName       String
  lastName         String
  birthDate        String
  age              String
  nationality      String
  civilStatus      String
  isMale           Boolean
  isFemale         Boolean
  yrStartedPlaying String
  mothersName      String
  fathersName      String
  courseAndYear    String
  contactNumber    String
  email            String  @unique(map: "StudentProfile_email_key")
  homeAddress      String
  weight           String
  height           String
  bloodType        String
  userId           String
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  item         String
  quantity     Int
  supplier     String
  stockinDate  DateTime
  userId       String
}

model coachprofile {
  id                         Int      @id @default(autoincrement())
  name                       String
  contactNumber              String
  sport                      String
  permanentTeam              String
  isMale                     Boolean  @default(false)
  isFemale                   Boolean  @default(false)
  emergencyContact           String
  emergencyContactPerson     String
  birthDate                  DateTime
  nationality                String
  weight                     Float?
  height                     Float?
  bloodType                  String?
  academicYear               String
  statusIsFulltime           Boolean  @default(false)
  statusIsParttime           Boolean  @default(false)     
  resumeUrl                  String?
  email                      String
  CreatedAt                  DateTime @default(now())
  UpdatedAt                  DateTime @updatedAt
  userId                     String
}

