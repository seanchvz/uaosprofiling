generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model sport {
  id       Int              @id @default(autoincrement())
  name     String
  // events events[]
  teams    team[]
  students studentprofile[]
  // coaches  coachprofile[]
}

model events {
  id           Int              @id @default(autoincrement())
  name         String
  startDate    DateTime
  endDate      DateTime
  CreatedAt    DateTime         @default(now())
  UpdatedAt    DateTime         @updatedAt
  eventDetails String?
  isExternal   Boolean          @default(false)
  isInternal   Boolean          @default(false)
  userId       String
  students     studentprofile[] @relation("StudentEvents")
  coaches      coachprofile[]
  StudentEvent StudentEvent[]
  teams        team[]           @relation("TeamEvents")
  // Sport        String
  // sportId      Int?
  // sport        sport?           @relation(fields: [sportId], references: [id])
}

model team {
  id        Int              @id @default(autoincrement())
  students  studentprofile[] @relation("TeamMembers")
  // sportId   Int?
  // sport     sport?           @relation(fields: [sportId], references: [id])
  teamName  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  events    events[]         @relation("TeamEvents")
  // sport     String
  sport     sport?           @relation(fields: [sportId], references: [id])
  sportId   Int?
}

model studentprofile {
  id                     Int            @id @default(autoincrement())
  firstName              String
  middleName             String
  lastName               String
  contactNumber          String
  landLineNumber         String
  // sport                  String
  sport                  sport?         @relation(fields: [sportId], references: [id])
  sportId                Int?
  birthDate              String
  nationality            String
  weight                 String?
  height                 String?
  bloodType              String?
  academicYear           String
  isMale                 Boolean        @default(false)
  isFemale               Boolean        @default(false)
  yrStartedPlaying       String
  mothersName            String?
  fathersName            String?
  guardiansName          String?
  courseAndYear          String
  emergencyContactPerson String
  emergencyContactNumber String
  email                  String         @unique(map: "StudentProfile_email_key")
  homeAddress            String
  statusIsActive         Boolean        @default(false)
  statusIsInactive       Boolean        @default(false)
  QPI                    String?
  remarks                String?
  CreatedAt              DateTime       @default(now())
  UpdatedAt              DateTime       @updatedAt
  userId                 String
  imageUrl               String?
  events                 events[]       @relation("StudentEvents")
  StudentEvent           StudentEvent[]
  teams                  team[]         @relation("TeamMembers")
}

model coachprofile {
  id                     Int      @id @default(autoincrement())
  firstName              String
  middleName             String
  lastName               String
  contactNumber          String
  landLineNumber         String
  permanentTeam          String
  isMale                 Boolean  @default(false)
  isFemale               Boolean  @default(false)
  emergencyContact       String
  emergencyContactPerson String
  birthDate              DateTime
  nationality            String
  weight                 Float?
  height                 Float?
  bloodType              String?
  academicYear           String
  statusIsFulltime       Boolean  @default(false)
  statusIsParttime       Boolean  @default(false)
  resumeUrl              String?
  email                  String
  remarks                String?
  CreatedAt              DateTime @default(now())
  UpdatedAt              DateTime @updatedAt
  userId                 String
  events                 events[]
  sport                  String
  // sportId                Int?
  // sport                  sport?   @relation(fields: [sportId], references: [id])
}

model inventoryitem {
  id          Int      @id @default(autoincrement())
  item        String
  quantity    Int
  supplier    String
  stockinDate DateTime
  userId      String
}

model StudentEvent {
  student   studentprofile @relation(fields: [studentId], references: [id])
  studentId Int
  event     events         @relation(fields: [eventId], references: [id])
  eventId   Int

  @@id([studentId, eventId])
}
